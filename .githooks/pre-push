#!/usr/bin/env bash
set -e

# Pre-push hook: verify working tree and version format before pushing
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

if [ ! -s version.txt ]; then
    echo "Error: version.txt is missing or empty." >&2
    exit 1
fi

CURRENT_VER=$(tr -d '[:space:]' < version.txt)

# Verify valid CalVer format
if [[ ! "$CURRENT_VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Error: Invalid CalVer format in version.txt: '${CURRENT_VER}'" >&2
    exit 1
fi

echo "CalVer pre-push verification passed: ${CURRENT_VER}"
